    {
      "name": "1b. Photo upload (multipart)",
      "description": "Uploads a real image with a new listing and checks that the server stores it as uploads/foods/Image_<food_id>.png. The sample image is in postman/sample-food.png; if Postman shows the file as missing, click the photos row in the Body tab and pick it manually. Run the requests in order: the cleanup request deletes the test listing, but the image file stays on disk (documented behavior).",
      "item": [
        {
          "name": "Upload photo -> Image_<food_id>",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "data",
                  "value": "{\n  \"food_id\": \"{{uploadFoodId}}\",\n  \"contributor_id\": \"usr_9842a7f1\",\n  \"verification_status\": \"pending\",\n  \"verification_details\": {},\n  \"food_details\": {\n    \"title\": \"Nasi Box Upload Postman\",\n    \"description\": \"Contoh upload foto lewat Postman.\",\n    \"category\": \"Makanan Berat\",\n    \"dietary_tags\": [\"Halal\"],\n    \"quantity_portions\": 4,\n    \"expiry_timestamp\": \"2026-12-31T12:00:00Z\",\n    \"photo_urls\": []\n  },\n  \"location\": {\n    \"location_name\": \"Kantin UB\",\n    \"address_text\": \"Jl. Veteran, Lowokwaru, Malang\",\n    \"coordinates\": {\n      \"latitude\": -7.9526,\n      \"longitude\": 112.6144\n    },\n    \"pickup_notes\": \"Ambil di kantin lantai 1.\"\n  },\n  \"status\": \"available\"\n}",
                  "type": "text"
                },
                {
                  "key": "photos",
                  "type": "file",
                  "src": "postman/sample-food.png",
                  "description": "Sample image bundled with this collection (PNG, 640x400). Select it manually if Postman cannot resolve the relative path."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/foods",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "foods"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('uploadFoodId', 'food_pm_upload_' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "",
                  "var data = pm.response.json().data;",
                  "var foodId = pm.collectionVariables.get('uploadFoodId');",
                  "",
                  "pm.test('created with the requested food_id', () => {",
                  "  pm.expect(data.food_id).to.eql(foodId);",
                  "});",
                  "",
                  "pm.test('photo is saved as Image_<food_id>.png', () => {",
                  "  pm.expect(data.food_details.photo_urls).to.have.lengthOf(1);",
                  "  pm.expect(data.food_details.photo_urls[0]).to.eql('/uploads/foods/Image_' + foodId + '.png');",
                  "});",
                  "",
                  "pm.collectionVariables.set('uploadedFoodId', data.food_id);",
                  "pm.collectionVariables.set('uploadedPhotoUrl', data.food_details.photo_urls[0]);"
                ]
              }
            }
          ]
        },
