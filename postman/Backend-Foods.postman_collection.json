{
  "info": {
    "name": "Backend Starter - Food Listings",
    "description": "Tests for the FoodItemListing API (Express + MongoDB). Start the backend with `npm run dev`, then run this collection top to bottom. Each request asserts HTTP status, response shape, MongoDB persistence, validation and error messages. The Delete folder removes the test documents, so the collection is safe to re-run. Folder 1b uploads postman/sample-food.png (select that file manually if Postman cannot resolve the relative path).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "foodId",
      "value": ""
    },
    {
      "key": "pendingFoodId",
      "value": ""
    },
    {
      "key": "autoFoodId",
      "value": ""
    },
    {
      "key": "uploadFoodId",
      "value": ""
    },
    {
      "key": "uploadedFoodId",
      "value": ""
    },
    {
      "key": "uploadedPhotoUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Create",
      "description": "Create food listings and validation cases.",
      "item": [
        {
          "name": "Create listing (full payload)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"food_id\": \"{{pendingFoodId}}\",\n  \"contributor_id\": \"usr_9842a7f1\",\n  \"created_at\": \"2026-11-08T09:00:00Z\",\n  \"verification_status\": \"approved\",\n  \"verification_details\": {\n    \"verified_by_admin_id\": \"adm_001\",\n    \"verified_at\": \"2026-11-08T09:15:00Z\",\n    \"rejection_reason\": null\n  },\n  \"food_details\": {\n    \"title\": \"Nasi Kotak Ayam Bakar (5 Porsi)\",\n    \"description\": \"Sisa acara ulang tahun keluarga, kondisi masih hangat dan higienis.\",\n    \"category\": \"Makanan Berat\",\n    \"dietary_tags\": [\n      \"Halal\",\n      \"Bebas Kacang\"\n    ],\n    \"quantity_portions\": 5,\n    \"expiry_timestamp\": \"2026-11-08T20:00:00Z\",\n    \"photo_urls\": [\n      \"https://images.app.example/foods/food_8821_1.jpg\"\n    ]\n  },\n  \"location\": {\n    \"location_name\": \"Depan Pos Satpam Kompleks Asri\",\n    \"address_text\": \"Jl. Mawar No. 12, Lowokwaru, Malang\",\n    \"coordinates\": {\n      \"latitude\": -7.9521,\n      \"longitude\": 112.6142\n    },\n    \"pickup_notes\": \"Makanan ditaruh di meja pos satpam. Silakan ambil langsung tanpa perlu mengetuk rumah.\",\n    \"external_map_url\": \"https://maps.google.com/?q=-7.9521,112.6142\"\n  },\n  \"status\": \"available\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/foods",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "foods"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('pendingFoodId', 'food_test_' + Date.now());",
                  "pm.collectionVariables.set('foodId', pm.collectionVariables.get('pendingFoodId'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "",
                  "var data = pm.response.json().data;",
                  "",
                  "pm.test('returns the saved listing', () => {",
                  "  pm.expect(data.food_id).to.eql(pm.collectionVariables.get('pendingFoodId'));",
                  "  pm.expect(data.contributor_id).to.eql('usr_9842a7f1');",
                  "  pm.expect(data.status).to.eql('available');",
                  "  pm.expect(data.verification_status).to.eql('approved');",
                  "});",
                  "",
                  "pm.test('verification details are stored', () => {",
                  "  pm.expect(data.verification_details.verified_by_admin_id).to.eql('adm_001');",
                  "  pm.expect(data.verification_details.verified_at).to.eql('2026-11-08T09:15:00.000Z');",
                  "  pm.expect(data.verification_details.rejection_reason).to.be.null;",
                  "});",
                  "",
                  "pm.test('food details are stored', () => {",
                  "  pm.expect(data.food_details.title).to.eql('Nasi Kotak Ayam Bakar (5 Porsi)');",
                  "  pm.expect(data.food_details.category).to.eql('Makanan Berat');",
                  "  pm.expect(data.food_details.dietary_tags).to.eql(['Halal', 'Bebas Kacang']);",
                  "  pm.expect(data.food_details.quantity_portions).to.eql(5);",
                  "  pm.expect(data.food_details.expiry_timestamp).to.eql('2026-11-08T20:00:00.000Z');",
                  "});",
                  "",
                  "pm.test('location is stored', () => {",
                  "  pm.expect(data.location.location_name).to.eql('Depan Pos Satpam Kompleks Asri');",
                  "  pm.expect(data.location.coordinates.latitude).to.eql(-7.9521);",
                  "  pm.expect(data.location.coordinates.longitude).to.eql(112.6142);",
                  "});",
                  "",
                  "pm.test('created_at is preserved (document persisted)', () => {",
                  "  pm.expect(data.created_at).to.eql('2026-11-08T09:00:00.000Z');",
                  "});",
                  "",
                  "pm.test('internal Mongo fields are hidden', () => {",
                  "  pm.expect(data).to.not.have.property('_id');",
                  "  pm.expect(data).to.not.have.property('__v');",
                  "});",
                  "",
                  "pm.collectionVariables.set('foodId', data.food_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create listing (minimal -> auto id + defaults)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contributor_id\": \"usr_test\",\n  \"food_details\": {\n    \"title\": \"Roti Sisa Bakery\",\n    \"category\": \"Snack\",\n    \"quantity_portions\": 2,\n    \"expiry_timestamp\": \"2026-12-01T10:00:00Z\"\n  },\n  \"location\": {\n    \"location_name\": \"Lobby Gedung A\",\n    \"coordinates\": {\n      \"latitude\": -7.9,\n      \"longitude\": 112.6\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/foods",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "foods"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "",
                  "var data = pm.response.json().data;",
                  "",
                  "pm.test('food_id is auto-generated', () => pm.expect(data.food_id).to.match(/^food_[0-9a-f]{8}$/));",
                  "",
                  "pm.test('defaults are applied', () => {",
                  "  pm.expect(data.status).to.eql('available');",
                  "  pm.expect(data.verification_status).to.eql('pending');",
                  "  pm.expect(data.verification_details.verified_at).to.be.null;",
                  "  pm.expect(data.food_details.dietary_tags).to.eql([]);",
                  "  pm.expect(data.food_details.photo_urls).to.eql([]);",
                  "});",
                  "",
                  "pm.test('map url is derived from coordinates', () => {",
                  "  pm.expect(data.location.external_map_url).to.eql('https://maps.google.com/?q=-7.9,112.6');",
                  "});",
                  "",
                  "pm.collectionVariables.set('autoFoodId', data.food_id);"
                ]
              }
            }
          ]
        },
