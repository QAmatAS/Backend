        {
          "name": "List with filters (status + contributor_id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/foods?status=available&contributor_id=usr_9842a7f1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "foods"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "available"
                },
                {
                  "key": "contributor_id",
                  "value": "usr_9842a7f1"
                }
              ]
            }
          },
