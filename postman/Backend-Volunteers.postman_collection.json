        {
          "name": "Apply - success (bob)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBob}}"
              }
            ],
            "url": "{{baseUrl}}/api/volunteers",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "data",
                  "value": "{\"full_name\": \"Bob Pelamar\", \"whatsapp\": \"0812-3456-7890\", \"email\": \"Bob@Example.com\"}",
                  "type": "text"
                },
                {
                  "key": "ktp",
                  "src": "dummy/ktp-sample.png",
                  "type": "file"
                }
              ]
            },
            "description": "Needs dummy/ktp-sample.png. If Postman cannot find the file, re-pick it in the `ktp` row (Body > form-data)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const v = pm.response.json().data;",
                  "pm.test(\"status is pending\", () => pm.expect(Boolean(v.status === 'pending')).to.eql(true));",
                  "pm.test(\"volunteer_id looks right\", () => pm.expect(Boolean(/^vol_[0-9a-f]{8}$/.test(v.volunteer_id))).to.eql(true));",
                  "pm.test(\"whatsapp is normalised to +62...\", () => pm.expect(Boolean(v.whatsapp === '+6281234567890')).to.eql(true));",
                  "pm.test(\"email is lower-cased\", () => pm.expect(Boolean(v.email === 'bob@example.com')).to.eql(true));",
                  "pm.test(\"ktp_url points at the authenticated endpoint\", () => pm.expect(Boolean(v.ktp_url === '/api/volunteers/' + v.volunteer_id + '/ktp')).to.eql(true));",
                  "pm.test(\"the stored file name is never exposed\", () => pm.expect(Boolean(!JSON.stringify(v).includes('ktp_file') && v.has_ktp === true)).to.eql(true));",
                  "pm.collectionVariables.set('volId', v.volunteer_id);",
                  "pm.collectionVariables.set('ktpUrl', v.ktp_url);"
                ]
              }
            }
          ]
        },
