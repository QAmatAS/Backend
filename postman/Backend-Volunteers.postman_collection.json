        },
        {
          "name": "List - admin sees the pending queue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": "{{baseUrl}}/api/volunteers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"bob's application is in the queue\", () => pm.expect(Boolean(body.data.some(v => v.volunteer_id === pm.collectionVariables.get('volId')))).to.eql(true));",
                  "pm.test(\"only pending items by default\", () => pm.expect(Boolean(body.data.every(v => v.status === 'pending'))).to.eql(true));",
                  "pm.test(\"summary has the four counters\", () => pm.expect(Boolean(['total','pending','approved','rejected'].every(k => typeof body.summary[k] === 'number'))).to.eql(true));",
                  "pm.test(\"no stored file names in the list\", () => pm.expect(Boolean(!JSON.stringify(body).includes('ktp_file'))).to.eql(true));"
                ]
              }
            }
          ]
        },
