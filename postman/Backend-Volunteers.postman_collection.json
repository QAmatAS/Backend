{
  "info": {
    "name": "Backend - Volunteers (NGO)",
    "description": "Volunteer application + admin review. Run top to bottom, on a clean state:\n1. npm run seed && npm run seed:admin\n2. npm run seed:volunteers -- --reset\nThe collection uses bob as the applicant, maya as an outsider and alice (admin) as reviewer. Re-run step 2 before every run. The KTP file part uses dummy/ktp-sample.png (a placeholder, not a real ID).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test(\"db is connected\", () => pm.expect(Boolean(pm.response.json().db === 'connected')).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - admin (alice)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"returns a bearer token\", () => pm.expect(Boolean(typeof body.token === 'string' && body.token.length > 0)).to.eql(true));",
                  "pm.collectionVariables.set('tokenAdmin', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - applicant (bob)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"returns a bearer token\", () => pm.expect(Boolean(typeof body.token === 'string' && body.token.length > 0)).to.eql(true));",
                  "pm.collectionVariables.set('tokenBob', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - other user (maya)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maya@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"returns a bearer token\", () => pm.expect(Boolean(typeof body.token === 'string' && body.token.length > 0)).to.eql(true));",
                  "pm.collectionVariables.set('tokenMaya', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sanity - alice really is an admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": "{{baseUrl}}/api/volunteers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test(\"alice can open the review queue (run npm run seed:admin if this fails)\", () => pm.expect(Boolean(true)).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
