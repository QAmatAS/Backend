{
  "info": {
    "name": "Backend - Auth",
    "description": "Register, login and profile. Run top to bottom. Requires `npm run seed` first (demo accounts use password123).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "newEmail",
      "value": ""
    },
    {
      "key": "originalBio",
      "value": ""
    },
    {
      "key": "avatarUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('database is connected', () => pm.expect(pm.response.json().db).to.eql('connected'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Register - success",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{newEmail}}\",\n  \"password\": \"secret123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('newEmail', 'postman_' + Date.now() + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const user = pm.response.json().data;",
              "pm.test('has a user_id', () => pm.expect(user.user_id).to.match(/^usr_[0-9a-f]{8}$/));",
              "pm.test('defaults to contributor', () => pm.expect(user.role).to.eql('contributor'));",
              "pm.test('never returns the password hash', () => pm.expect(user.passwordHash).to.be.undefined);",
              "pm.test('has personal_info', () => pm.expect(user.personal_info.display_name).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "Register - duplicate email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{newEmail}}\",\n  \"password\": \"secret123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 409', () => pm.response.to.have.status(409));",
              "pm.test('message names the email field', () => pm.expect(pm.response.json().error.message).to.eql('Email is already registered'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Register - short password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Short\",\n  \"email\": \"short@example.com\",\n  \"password\": \"123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login - success",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('returns a bearer token', () => { pm.expect(body.token).to.be.a('string').and.not.empty; pm.expect(body.tokenType).to.eql('Bearer'); });",
              "pm.test('returns the user without the hash', () => pm.expect(body.user.passwordHash).to.be.undefined);",
              "pm.collectionVariables.set('token', body.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login - wrong password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"nope\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 401', () => pm.response.to.have.status(401));",
              "pm.test('same message as an unknown email', () => pm.expect(pm.response.json().error.message).to.eql('Invalid email or password'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login - missing fields",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Me - success",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const user = pm.response.json().data;",
              "pm.test('has identity and role', () => { pm.expect(user.user_id).to.match(/^usr_/); pm.expect(user.role).to.be.oneOf(['contributor', 'admin']); });",
              "pm.test('stats are derived', () => pm.expect(user.stats).to.have.all.keys('total_shared_submitted', 'total_shared_approved', 'rating'));",
              "pm.collectionVariables.set('myUserId', user.user_id);",
              "pm.collectionVariables.set('originalBio', user.personal_info.bio);"
            ]
          }
        }
      ]
    },
    {
      "name": "Me - update profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/me",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"personal_info\": {\n    \"bio\": \"Diperbarui oleh Postman\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const user = pm.response.json().data;",
              "pm.test('bio is updated', () => pm.expect(user.personal_info.bio).to.eql('Diperbarui oleh Postman'));",
              "pm.test('name and role are untouched', () => { pm.expect(user.name).to.be.a('string').and.not.empty; pm.expect(user.role).to.be.oneOf(['contributor', 'admin']); });",
              "pm.test('returns derived stats', () => pm.expect(user.stats).to.have.all.keys('total_shared_submitted', 'total_shared_approved', 'rating'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Me - restore profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/me",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"personal_info\": {\n    \"bio\": \"{{originalBio}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('bio restored', () => pm.expect(pm.response.json().data.personal_info.bio).to.eql(pm.collectionVariables.get('originalBio')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Me - upload avatar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/me/avatar",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "avatar",
              "src": "postman/sample-food.png",
              "type": "file"
            }
          ]
        },
        "description": "Multipart upload, field `avatar`. If Postman cannot resolve the relative path, pick the file manually."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const user = pm.response.json().data;",
              "pm.test('avatar points into the uploads folder', () => pm.expect(user.personal_info.avatar_url).to.match(/^\\/uploads\\/avatars\\/avatar_/));",
              "pm.test('profile shape is unchanged', () => pm.expect(user.stats).to.have.all.keys('total_shared_submitted', 'total_shared_approved', 'rating'));",
              "pm.collectionVariables.set('avatarUrl', user.personal_info.avatar_url);"
            ]
          }
        }
      ]
    },
    {
      "name": "Me - delete avatar",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/me/avatar",
        "description": "Removes the stored file so running this collection leaves no leftovers."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('avatar cleared', () => pm.expect(pm.response.json().data.personal_info.avatar_url).to.eql(''));"
            ]
          }
        }
      ]
    },
    {
      "name": "Me - no token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 401', () => pm.response.to.have.status(401));",
              "pm.test('explains why', () => pm.expect(pm.response.json().error.message).to.eql('Authentication required'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Me - invalid token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{not-a-real-token}}"
          }
        ],
        "url": "{{baseUrl}}/api/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
