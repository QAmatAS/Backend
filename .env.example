# Copy this file to .env and adjust the values. Never commit .env.
NODE_ENV=development

# HTTP port for the API
PORT=3000

# Local MongoDB. Change the database name or point to Atlas if needed.
MONGODB_URI=mongodb://localhost:27017/backend

# Secret used to sign login tokens (JWT). Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Token lifetime
JWT_EXPIRES_IN=1d

# Account promoted by `npm run seed:admin`
ADMIN_EMAIL=alice@example.com

# Public name used by `npm run tunnel`. Keep it fixed so the mobile app can use
# one base URL (https://<TUNNEL_SUBDOMAIN>.loca.lt); change it if the name is
# already taken on localtunnel.
TUNNEL_SUBDOMAIN=spoonshare-test-tunnel
