# Copy this file to .env and adjust the values
NODE_ENV=development
PORT=3000

# Local MongoDB. Change the database name or point to Atlas if needed.
MONGODB_URI=mongodb://localhost:27017/backend

# Secret used to sign login tokens (JWT). Use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Optional: request a fixed subdomain for `npm run tunnel`, e.g. my-papb-app
# (must be unique on localtunnel; leave empty for a random one).
TUNNEL_SUBDOMAIN=
